NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# "true" opens episode results entry to every signed-in user instead of just
# profiles.is_super_admin. Unset/anything else keeps it admin-only.
RESULTS_ENTRY_OPEN_TO_ALL=
# Personal access token from supabase.com/dashboard/account/tokens. Only needed
# to regenerate src/lib/supabase/types.ts (see CLAUDE.md); the app never reads it.
SUPABASE_ACCESS_TOKEN=
